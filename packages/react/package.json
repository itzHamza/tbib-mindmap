{
  "name": "@tbib-mindmap/react",
  "version": "0.1.0",
  "description": "React interactive component and controls for TBiB Mindmap",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tbib-mindmap/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "framer-motion": "^12.40.0",
    "happy-dom": "^20.14.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "mindmap",
    "markdown-mindmap",
    "react-mindmap",
    "diagram",
    "framer-motion"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
