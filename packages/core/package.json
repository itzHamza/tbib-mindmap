{
  "name": "@tbib-mindmap/core",
  "version": "0.1.0",
  "description": "Framework-agnostic engine for markdown mindmaps and tree layouts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mindmap",
    "markdown-mindmap",
    "tree-layout",
    "markmap",
    "diagram",
    "graph"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
